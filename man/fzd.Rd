  result <- fzd(
    tf,
    list(x = "[0;1]", y = "[-5;5]"),
    model,
    output_expression = "z",
    algorithm        = "algorithms/montecarlo_uniform.py",
    algorithm_options = list(batch_sample_size = 10, max_iterations = 3)
  )
}
